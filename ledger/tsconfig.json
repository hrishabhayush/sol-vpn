{
  "compilerOptions": {
    "types": ["node"],
    "lib": ["es2022", "dom"],
    "module": "nodenext",
    "target": "es2022",
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true
  },
  "include": ["client", "tests", "scripts"]
}
